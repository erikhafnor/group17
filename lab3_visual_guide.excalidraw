   "id": "e0074"
  },
  {
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "roughness": 1,
   "opacity": 100,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "seed": 297015553,
   "version": 1,
   "versionNonce": 1156179110,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "x": 88,
   "y": 1230,
   "width": 801.36,
   "height": 35.0,
   "text": "47x slower to write and 2.6x slower to query. Pruning saves you from reading files; here the files are\ntiny, so you pay the per-file open cost many times over and save nothing. This is the small-files problem.",
   "originalText": "47x slower to write and 2.6x slower to query. Pruning saves you from reading files; here the files are\ntiny, so you pay the per-file open cost many times over and save nothing. This is the small-files problem.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "containerId": null,
   "lineHeight": 1.25,
   "id": "e0075"
  },
  {
   "angle": 0,
   "groupIds": [],
   "frameId": null,
