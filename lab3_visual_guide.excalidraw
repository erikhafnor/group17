   "y": 3836,
   "width": 356.40000000000003,
   "height": 45.0,
   "text": "valid_to = 9999-12-31 is the sentinel for 'still true'.\nis_current marks the live version so simple queries\nstay simple.",
   "originalText": "valid_to = 9999-12-31 is the sentinel for 'still true'.\nis_current marks the live version so simple queries\nstay simple.",
