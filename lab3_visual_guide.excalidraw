   "width": 369.36,
   "height": 23.75,
   "text": "Questions worth being able to answer",
   "originalText": "Questions worth being able to answer",
   "fontSize": 19,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#1971c2",
