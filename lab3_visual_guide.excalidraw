  },
  {
   "angle": 0,
   "groupIds": [],
   "frameId": null,
   "roughness": 1,
   "opacity": 100,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "seed": 1747101363,
   "version": 1,
   "versionNonce": 357356203,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "x": 60,
   "y": 320,
   "width": 834.3000000000001,
   "height": 37.5,
   "text": "A pipeline is not one big script - it is stages that read each other's output. Each stage can be re-run\nalone, tested alone, and replaced alone. Lab 3 proves the contract by consuming Lab 2's output cold.",
   "originalText": "A pipeline is not one big script - it is stages that read each other's output. Each stage can be re-run\nalone, tested alone, and replaced alone. Lab 3 proves the contract by consuming Lab 2's output cold.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
