   "type": "text",
   "x": 92,
   "y": 3895,
   "width": 358.02000000000004,
   "height": 48.75,
   "text": "The watermark must be stored DURABLY and\nupdated only after a successful write - otherwise\na crash mid-run either loses or double-counts data.",
   "originalText": "The watermark must be stored DURABLY and\nupdated only after a successful write - otherwise\na crash mid-run either loses or double-counts data.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "containerId": null,
   "lineHeight": 1.25,
   "id": "e0230"
  },
  {
   "angle": 0,
