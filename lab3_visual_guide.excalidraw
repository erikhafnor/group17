   "locked": false,
   "type": "text",
   "x": 92,
   "y": 3985,
   "width": 294.84000000000003,
   "height": 48.75,
   "text": "This is the pattern the monthly cron in\npipeline.yml would need before it could be\ntrusted to run unattended.",
   "originalText": "This is the pattern the monthly cron in\npipeline.yml would need before it could be\ntrusted to run unattended.",
