   "width": 515.1600000000001,
   "height": 22.5,
   "text": "Read that table again - partitioning LOST, twice over",
   "originalText": "Read that table again - partitioning LOST, twice over",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "containerId": null,
