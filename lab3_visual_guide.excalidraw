   "width": 359.1,
   "height": 23.75,
   "text": "Why that matters more than it looks",
   "originalText": "Why that matters more than it looks",
   "fontSize": 19,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
